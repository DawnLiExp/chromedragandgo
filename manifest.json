{
  "manifest_version": 3,
  "minimum_chrome_version": "99",
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "2.1.0",
  "default_locale": "en",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dragandgo.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "icons": {
    "32": "dragandgo_32x32.png",
    "48": "dragandgo_48x48.png",
    "128": "dragandgo_128x128.png"
  }
}
